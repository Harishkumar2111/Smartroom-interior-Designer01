# Environment: development or production
ENV=development

# Database URL (SQLite used by default in backend directory)
DATABASE_URL=sqlite:///./smartroom.db

# File storage paths
UPLOAD_DIR=./uploads
GENERATED_DIR=./generated
MAX_UPLOAD_SIZE_MB=15

# Vision AI API key (Google Gemini API)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Optional image generation API key (e.g., Imagen, Stability, DALL-E)
IMAGE_GEN_API_KEY=YOUR_IMAGE_GEN_API_KEY_HERE

# Allowed frontend origins for CORS (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000
